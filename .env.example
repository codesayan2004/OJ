# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=codespher.me,www.codespher.me,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://codespher.me,https://www.codespher.me
# Set to 0 only when testing over plain http://localhost
DJANGO_SECURE_COOKIES=1

# --- AI review (Google Gemini) -----------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Sandbox -----------------------------------------------------------------
SANDBOX_TIME_LIMIT=2
SANDBOX_MEMORY_MB=256

# --- Gunicorn ----------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Docker / deployment -------------------------------------------------------
# Group id that owns /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# local.conf = plain HTTP (local / first boot), codesphere.conf = HTTPS
NGINX_CONF=local.conf
# Set by deploy/ec2_deploy.sh to the ECR image URIs
# WEB_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/codesphere-web:latest
# RUNNER_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/codesphere-runner:latest
